# Production environment variables for the frontend.
# Set VITE_API_URL to the full backend URL when deploying frontend and backend
# to separate origins (e.g. Vercel + Render). In development, the Vite proxy
# handles /api routing, so this stays empty.
#
# Example: VITE_API_URL=https://motiv-api.onrender.com
VITE_API_URL=
